# === Tokenvault frontend env ===
#
# Backend (Django/Gunicorn) is published on the host at :8000
# (docker-compose maps "8000:8000" in the django service).
# nginx on :80 is still available — use it instead if you want
# static files / websockets to go through one origin.
#
# Use option A *or* option B, not both.

# --- Option A: absolute URL (default) ---------------------------------
# Hits Django directly. CORS is allowed for http://localhost:5173 via
# backend/.env -> ALLOWED_ORIGINS, so the browser is happy.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws

# --- Option B: relative URL + Vite dev proxy --------------------------
# Avoids browser CORS entirely (same-origin to the Vite server,
# proxied to the target below). Uncomment to switch:
# VITE_API_BASE_URL=/api/v1
# VITE_WS_BASE_URL=/ws

# Target of the Vite dev proxy (only used in option B)
VITE_DEV_API_TARGET=http://localhost:8000
