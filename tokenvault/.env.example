# === Tokenvault frontend env ===
#
# Production backend is behind nginx on http://mngi8fgq3ea1.dx1dx.com
# (nginx :80 proxies /api/v1 -> django:8000 and /ws -> daphne:9000).
# For local dev you can swap these for http://localhost:8000 / ws://localhost:8000.
#
# Use option A *or* option B, not both.

# --- Option A: absolute URL (default) ---------------------------------
# Hits the backend directly. The backend allows http://localhost:5173 as a
# CORS origin (see backend/.env -> ALLOWED_ORIGINS), so the dev browser is happy.
VITE_API_BASE_URL=http://mngi8fgq3ea1.dx1dx.com/api/v1
VITE_WS_BASE_URL=ws://mngi8fgq3ea1.dx1dx.com/ws

# --- Option B: relative URL + Vite dev proxy --------------------------
# Avoids browser CORS entirely (same-origin to the Vite server,
# proxied to the target below). Uncomment to switch:
# VITE_API_BASE_URL=/api/v1
# VITE_WS_BASE_URL=/ws

# Target of the Vite dev proxy (only used in option B)
VITE_DEV_API_TARGET=http://mngi8fgq3ea1.dx1dx.com
