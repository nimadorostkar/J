# === Production build env (loaded by `vite build`, used by Vercel) ===
# This file IS committed to git so Vercel builds get the right backend URL.
# Do NOT put secrets here — Vite inlines these values into the public JS bundle.
#
# Backend is served via Cloudflare-fronted HTTPS at houston.avro-cafe.ir.
# Direct CORS calls work because the page (Vercel) and the API (Cloudflare)
# both speak HTTPS, so no mixed-content blocking.
VITE_API_BASE_URL=https://houston.avro-cafe.ir/api/v1
VITE_WS_BASE_URL=wss://houston.avro-cafe.ir/ws

# Dev-only target for the Vite proxy in vite.config.js (not used in prod build).
VITE_DEV_API_TARGET=https://houston.avro-cafe.ir
