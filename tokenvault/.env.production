# === Production build env (loaded by `vite build`, used by Vercel) ===
# This file IS committed to git so Vercel builds get the right backend URL.
# Do NOT put secrets here — Vite inlines these values into the public JS bundle.
#
# We use a RELATIVE path here. Vercel's rewrite in vercel.json proxies
#   https://jfrontendtesting.vercel.app/api/*  ->  http://mngi8fgq3ea1.dx1dx.com/api/*
# server-side, so the browser only ever makes same-origin HTTPS requests
# (no mixed-content blocking, no CORS preflight).
VITE_API_BASE_URL=/api/v1

# WebSockets cannot be proxied via Vercel rewrites — they require a true
# `wss://` endpoint, which means the backend needs TLS. Until then this
# value points at the backend directly; WS calls from the HTTPS frontend
# will be blocked by the browser, so don't wire up websockets in prod yet.
VITE_WS_BASE_URL=ws://mngi8fgq3ea1.dx1dx.com/ws

# Dev-only target for the Vite proxy in vite.config.js (not used in prod build).
VITE_DEV_API_TARGET=http://mngi8fgq3ea1.dx1dx.com
