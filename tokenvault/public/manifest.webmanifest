    { "name": "Trade",   "short_name": "Trade",   "url": "/trade",   "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Network", "short_name": "Network", "url": "/network", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
