# === FILE: backend/.env.example ===
DEBUG=False
SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_SETTINGS_MODULE=core.settings.prod
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost

# Database
DATABASE_URL=postgres://tokenvault:password@postgres:5432/tokenvault

# Redis / Celery / Channels
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNEL_LAYERS_URL=redis://redis:6379/3

# JWT
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Blockchain
TRON_API_KEY=
ETHEREUM_API_KEY=
USDT_TRC20_WALLET=
USDT_ERC20_WALLET=
BLOCKCHAIN_WEBHOOK_SECRET=change-me

# Economics
USDT_PER_HCOIN=10
MIN_DEPOSIT_USDT=10
WITHDRAWAL_FEE_USDT=1
WITHDRAWAL_AUTO_APPROVE=False
REWARD_DURATION_HOURS=12
REWARD_AMOUNT_HCOIN=5
GLOBAL_CYCLE_DAYS=30

# Referral commission rates (percent)
REFERRAL_L1_COMMISSION_PCT=5
REFERRAL_L2_COMMISSION_PCT=3

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
USE_S3=False

# Field-level encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=kBwy_DKvJjAfHRr3wnPHHfRz0wYwAtAVgmJxhJOyZc4=

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@tokenvault.io

# Frontend
FRONTEND_BASE_URL=http://localhost:5173

# --- Throttling (dev: bumped for bulk testing) ---
THROTTLE_REGISTER_RATE=200/min
THROTTLE_LOGIN_RATE=200/min
THROTTLE_FORGOT_PASSWORD_RATE=20/min
